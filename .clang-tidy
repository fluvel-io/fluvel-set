# bugprone-incorrect-roundings is disabled: the filters clamp the value to [0, 255] before
# "(int)(v + 0.5)", so the rounding is correct.
Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-default-member-init,
  modernize-use-static-cast,
  readability-identifier-naming,
  -bugprone-narrowing-conversions,
  -bugprone-easily-swappable-parameters,
  -bugprone-incorrect-roundings,
  -performance-enum-size,
  misc-unused-includes,
  modernize-use-forward-declaration,
  cppcoreguidelines-pro-type-member-init,
  hicpp-member-init

WarningsAsErrors: ''

HeaderFilterRegex: 'src/.*'

CheckOptions:

  # === Naming rules ===

  # Namespaces → lower_case
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case

  # Classes → CamelCase (UpperCamel)
  - key: readability-identifier-naming.ClassCase
    value: CamelCase

  # Structs → CamelCase (UpperCamel)
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  # Allowed: a type-suffix such as Lab_f, Components_3i
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^[A-Z][A-Za-z0-9]*_[a-z0-9]+$'

  # Enums → CamelCase (UpperCamel)
  - key: readability-identifier-naming.EnumCase
    value: CamelCase

  # Enum values → CamelCase (UpperCamel)
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase

  # Type aliases (using / typedef) → CamelCase (UpperCamel)
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  # Allowed: a type-suffix such as Rgb_uc, Point2D_f, and the std::chrono-style 'clock'
  - key: readability-identifier-naming.TypeAliasIgnoredRegexp
    value: '^([A-Z][A-Za-z0-9]*_[a-z0-9]+|clock)$'

  # Functions → camelBack
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  # Allowed: to_string(), the standard library convention (found by ADL)
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^to_string$'

  # Methods → camelBack
  - key: readability-identifier-naming.MethodCase
    value: camelBack

  # Local variables → camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  # Allowed: single capital letter (mathematical notation, e.g. L of Lab)
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^[A-Z]$'

  # Parameters → camelBack
  - key: readability-identifier-naming.ParameterCase
    value: camelBack

  # Private members → camelBack
  - key: readability-identifier-naming.PrivateMemberCase
    value: camelBack
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _

  # Protected members → camelBack
  - key: readability-identifier-naming.ProtectedMemberCase
    value: camelBack
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _

  # Static data members → camelBack with the private suffix
  - key: readability-identifier-naming.ClassMemberCase
    value: camelBack
  - key: readability-identifier-naming.ClassMemberSuffix
    value: _

  # Public members → camelBack
  - key: readability-identifier-naming.PublicMemberCase
    value: camelBack
  # Allowed: mathematical notation (L, X, Y, Z of a color space, Na, Ns of the algorithm)
  - key: readability-identifier-naming.PublicMemberIgnoredRegexp
    value: '^[A-Z][a-z]?$'

  # Global constants → kConstantName
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase

  # Macros → UPPER_CASE
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
