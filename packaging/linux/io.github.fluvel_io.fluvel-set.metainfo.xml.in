<?xml version="1.0" encoding="UTF-8"?>

<component type="desktop-application">

  <id>io.github.fluvel_io.fluvel-set</id>

  <name>Fluvel Set</name>

  <summary>Level-set image segmentation</summary>

  <summary xml:lang="fr">Segmentation d’image par level-set</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>CECILL-2.1-only</project_license>

  <content_rating type="oars-1.1"/>

  <description>

    <p>
      Fluvel Set is a research-oriented image segmentation application designed
      for fast and efficient experimentation with level-set active contour methods.
    </p>

    <p>
      It provides real-time image processing, video stream support,
      pre-processing tools, and quantitative evaluation metrics such as
      Hausdorff distance for segmentation analysis.
    </p>

    <p xml:lang="fr">
      Fluvel Set est une application de segmentation d’image orientée recherche,
      conçue pour des expérimentations rapides et efficaces avec des méthodes
      de contours actifs basées sur les ensembles de niveaux.
    </p>

    <p xml:lang="fr">
      Elle propose un traitement d’image en temps réel, la gestion de flux vidéo,
      des outils de prétraitement ainsi que des métriques d’évaluation
      quantitatives telles que la distance de Hausdorff pour l’analyse
      de segmentation.
    </p>

  </description>

  <categories>
    <category>Science</category>
    <category>Graphics</category>
  </categories>

  <launchable type="desktop-id">
    io.github.fluvel_io.fluvel-set.desktop
  </launchable>

  <developer id="io.github.fluvel_io">
    <name>Fabien Bessy</name>
  </developer>

  <url type="homepage">
    https://fluvel-io.github.io/fluvel-set
  </url>

  <url type="vcs-browser">
    https://github.com/fluvel-io/fluvel-set
  </url>

  <url type="bugtracker">
    https://github.com/fluvel-io/fluvel-set/issues
  </url>

  <url type="donation">
    https://www.paypal.me/fabienbessy
  </url>

  <releases>
    <release version="@PROJECT_VERSION@"
             date="@FLUVEL_RELEASE_DATE@"/>
  </releases>

  <screenshots>

    <screenshot type="default">
      <image>
        https://fluvel-io.github.io/fluvel-set/assets/images/segmentation-start.webp
      </image>
      <caption>Starting a level-set segmentation from an initial contour</caption>
      <caption xml:lang="fr">Début d’une segmentation par level-set à partir d’un contour initial</caption>
    </screenshot>

    <screenshot>
      <image>
        https://fluvel-io.github.io/fluvel-set/assets/images/segmentation-result.webp
      </image>
      <caption>Segmentation result with the final contour</caption>
      <caption xml:lang="fr">Résultat de la segmentation avec le contour final</caption>
    </screenshot>

    <screenshot>
      <image>
        https://fluvel-io.github.io/fluvel-set/assets/images/settings.webp
      </image>
      <caption>Session settings of the active contour algorithm</caption>
      <caption xml:lang="fr">Réglages de session de l’algorithme de contour actif</caption>
    </screenshot>

  </screenshots>

</component>
